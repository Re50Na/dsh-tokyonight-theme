{
  "name": "dsh-tokyonight-theme",
  "description": "Tokyo Night themes for DeepSeek Harness \u2014 Night, Storm and Light, with optional glass effects.",
  "version": "0.1.0-beta.0",
  "icon": "icon.png",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.1"
  },
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Re50Na/dsh-tokyonight-theme.git"
  },
  "homepage": "https://github.com/Re50Na/dsh-tokyonight-theme#readme",
  "bugs": {
    "url": "https://github.com/Re50Na/dsh-tokyonight-theme/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "dsh-plugin",
    "tokyonight"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./tui-themes": "./lib/tui-themes.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.1",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "files": [
    "lib",
    "themes",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "LICENSE",
    "*.map",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/gen-glass-css.mjs && tsdown",
    "prepare": "node scripts/gen-glass-css.mjs && tsdown",
    "watch": "node scripts/gen-glass-css.mjs && tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run",
    "docs:api": "typedoc",
    "gen:palettes": "node scripts/generate-palettes.mjs",
    "gen:themes": "node scripts/generate-tui-themes.mjs",
    "changelog:gen": "node scripts/gen-changelog.mjs",
    "gen:shiki": "node scripts/generate-shiki-tokens.mjs",
    "gen:all": "pnpm gen:palettes && pnpm gen:shiki && pnpm gen:themes"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
