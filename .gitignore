# Dependencies
node_modules/

# Prebuilt runtime is committed for script-free Git installs
!lib/
!lib/**

# Other build output
dist/

# Test / tooling artifacts
coverage/
*.tsbuildinfo

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Accidental nested clone / scratch directories (never part of this repo)
awesome-dsh-plugin/

# Agent scratch / working directories
.workbuddy/
# Newer agent workspace dir (project memory: MEMORY.md + daily logs). Local by
# design — never push it; the portable rules live in AGENTS.md / docs/ instead.
.workbuddy-ai/
.dsh-vision-toolkit/
# Local plugin runtime state — the meow-memory plugin writes its sqlite db into
# whatever cwd it is launched from, which is this repo when running the shell here.
.dsh-meow/
# Agent tool config. On this machine it is already covered by the GLOBAL git
# ignore (~/.config/git/ignore), but that is not portable — keep it here too.
.claude/
.agent/
.codex/

# Local debugging / scratch artifacts (one-off Playwright debug scripts, screenshots, chat test files)
debug-*.cjs
debug-*.png
quicksort.py

# Generic fallbacks — the rules above cover every scratch DIR, but these two leak
# past them when a tool writes a loose file into the repo root. `.env` first:
# an API key in a root `.env` would otherwise be one `git add -A` away.
# (No tracked file matches either rule as of 2026-10-14; if a `.env.example` is
# ever added, whitelist it with a `!.env.example` line right below.)
.env*
*.log

# Scratch dirs/files from local debugging sessions (CDP dumps, pasted bundles)
.debug/
.pideck-paste/
.client-*.tmp.ts

# Stray local pnpm store (should live outside the repo)
.pnpm-store/

# Local caches that must NOT land in the repo: scripts here pass `--cache .cache/npm`
# on machines with a tight C: drive (README/AGENTS 的 npm 缓存约定), and release
# verification downloads tarballs into .cache/ too. Not ignored until 2026-09-27,
# when one `git add -A` swept 19 npm-cache files + a published tarball into a commit.
.cache/

# Generated API docs (typedoc) — regenerate on demand with `pnpm docs:api`
docs/api/

# Preview intermediates (regenerated by scripts/screenshot-previews.cjs)
assets/previews/hero-*.png

# Package archives and local package-manager caches
*.tgz
.npm/
.yarn/cache/

# Test runner reports and caches
.vite/
.vitest/
.nyc_output/
test-results/
playwright-report/
blob-report/
.eslintcache
.stylelintcache
.prettiercache

# Python helper-script artifacts
__pycache__/
*.py[cod]
.venv/

# Local temporary files
.tmp/
*.tmp
*.swp
*.swo
*~

# Shareable environment templates (real environment files stay ignored)
!.env.example
!.env.sample
